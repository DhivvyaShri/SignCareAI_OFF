# Copy values into the backend process environment. Never commit real secrets.
HOST=127.0.0.1
PORT=8000
HOSPITAL_AUTH_SECRET=replace-with-a-long-random-secret
ISL_CONFIDENCE_THRESHOLD=0.65

# Optional hosted Nemotron via NVIDIA NIM; secret stays on Flask backend.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# Optional local Ollama endpoint/model.
LOCAL_AI_URL=http://localhost:11434/api/generate
LOCAL_AI_MODEL=nemotron-mini
